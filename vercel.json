{
  "cleanUrls": true,
  "functions": {
    "server.mjs": {
      "includeFiles": [
        "index.html",
        "client.js",
        "styles.css",
        "dual-agent-mandate-template.json",
        "assets/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
